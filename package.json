{
  "name": "gpu-lab-pro",
  "version": "2.0.0",
  "description": "GPU LAB Pro — 多厂商显卡驱动、DDU清理、控制中心与着色器缓存调试工作台",
  "main": "dist-electron/main.js",
  "author": "GPU LAB Community",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "start": "npm run build && electron .",
    "pack:exe": "npm run build && electron-builder --win portable",
    "verify:services": "npm run build:electron && node scripts/verify-services.mjs"
  },
  "build": {
    "appId": "com.gpulab.pro",
    "productName": "GPU LAB Pro",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "GPU-LAB-Pro-${version}.exe"
    }
  },
  "dependencies": {
    "lucide-react": "^0.460.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
